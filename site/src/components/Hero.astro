---
// Hero: the live run as one terminal. The window shows the real entry.yaml
// excerpt (labeled as an excerpt — the full file is longer), then the real
// command and its real output. CLI line mirrors src/cli.ts; the only display
// liberty is shortening the absolute output path to `manifest.json`.
// YAML text mirrors plugins/cc-marketspec/entry.yaml so the page never ships
// fake data.
---
<section id="hero" class="section">
  <div class="wrap hero">
    <div class="hero-copy reveal">
      <span class="eyebrow">The live run</span>
      <h1 class="hero-h1">Ship <em>data</em>,<br>not design.</h1>
      <p class="hero-lede">Describe your marketplace as a little YAML. cc-marketspec
        joins it with your native plugin manifests and emits one render-agnostic
        <span class="codechip">manifest.json</span>.</p>
      <p class="hero-contrast"><span>~8 lines of YAML</span> in, <span>a full marketplace manifest</span> out.</p>
      <div class="hero-cta">
        <a class="btn-primary" href="#quick-start">npx @xbluesky/cc-marketspec</a>
        <a class="btn-ghost" href="#mental-model">Read the mental model →</a>
      </div>
    </div>
    <div class="hero-visual reveal">
      <figure class="term herot">
        <figcaption class="term-bar"><i></i><i></i><i></i><span>entry.yaml — excerpt · then one real run</span></figcaption>
        <pre class="term-body"><code><span class="yline" style="--i:0"><span class="c"># presentation overlay — never restates native</span></span><span class="yline" style="--i:1"><span class="k">group</span><span class="p">:</span> <span class="s">tools</span></span><span class="yline" style="--i:2"><span class="k">tagline</span><span class="p">:</span> <span class="s">Headless data standard + generator for a Claude Code marketplace&#39;s presentation</span></span><span class="yline" style="--i:3"><span class="k">tips</span><span class="p">:</span></span><span class="yline" style="--i:4">  <span class="p">-</span> <span class="s">This repo is itself a cc-marketspec marketplace — it dogfoods its own framework.</span></span><span class="yline" style="--i:5">  <span class="p">-</span> <span class="k">text</span><span class="p">:</span> <span class="s">Ask the hosted MCP for field help without installing anything.</span></span><span class="yline" style="--i:6">    <span class="k">href</span><span class="p">:</span> <span class="s">https://github.com/XBlueSky/cc-marketspec#hosted-mcp-server</span></span><span class="yline hero-cmd" style="--i:7"><span class="prompt">$ </span>npx @xbluesky/cc-marketspec</span><span class="yline ok-line glow-ok" style="--i:14">cc-marketspec: wrote manifest.json — 1 plugins, 0 warning(s).</span><span class="yline" style="--i:15" aria-hidden="true"><span class="prompt">$ </span><span class="cursor"></span></span></code></pre>
      </figure>
      <p class="arrow hero-gen" aria-hidden="true">↓ rendered from that manifest ↓</p>
      <div class="minicard hero-gen">
        <h3>cc-marketspec</h3>
        <p class="minicard-tag">Headless data standard + generator for a marketplace's presentation</p>
        <div class="minicard-chips"><b>1 skill</b><b>3 commands</b><b>1 mcp</b></div>
        <p class="minicard-row"><code>/cc-generate</code> Generate manifest.json from your data.</p>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { display:grid; grid-template-columns:1.05fr 1fr; gap:2.5rem; align-items:center; }
  .hero > * { min-width:0; }
  .hero-h1 { font-size:var(--hero-size); margin:1.2rem 0 1rem; }
  .hero-h1 em { font-style:normal; color:var(--accent); text-shadow:0 0 24px rgba(255,122,69,.35);
    /* large display text — AA-large passes at 7.48 on --bg */ }
  .hero-lede { color:var(--muted); font-size:1.05rem; max-width:46ch; margin:0 0 1.8rem; }
  .hero-contrast { font-family:var(--mono); font-size:.8rem; color:var(--muted); margin:0 0 1.6rem; }
  .hero-contrast span { color:var(--accent-ink); }
  .hero-cta { display:flex; gap:1rem; align-items:center; flex-wrap:wrap; }
  .herot { box-shadow:0 12px 48px rgba(0,0,0,.45); }
  .k{color:var(--accent-ink);} .s{color:var(--syntax-string);} .c{color:var(--syntax-comment);} .p{color:var(--syntax-punct);}
  .arrow { position:relative; text-align:center; font-family:var(--mono); font-size:.7rem; color:var(--muted); margin:1.1rem 0; }
  .arrow::before { content:''; position:absolute; left:50%; top:-1.1rem; width:2px; height:1.1rem; background:var(--accent); opacity:.5; transform:translateX(-50%); }
  .arrow::after { content:''; position:absolute; left:50%; bottom:-1.1rem; width:2px; height:1.1rem; background:var(--accent); opacity:.5; transform:translateX(-50%); }
  .minicard { display:flex; flex-direction:column; min-width:0; background:var(--surface);
    border:1px solid var(--border); border-radius:10px; padding:1.1rem 1.2rem; }
  .minicard h3 { font-size:1.15rem; }
  .minicard-tag { color:var(--muted); font-size:.85rem; margin:.2rem 0 .8rem; }
  .minicard-chips { display:flex; flex-wrap:wrap; gap:.35rem; margin-bottom:.6rem; }
  .minicard-chips b { font-family:var(--mono); font-size:.68rem; font-weight:500;
    background:var(--code-chip); color:var(--accent-ink); border-radius:5px; padding:.2rem .5rem; }
  .minicard-row { font-size:.82rem; color:var(--muted); margin:0; }
  .minicard-row code { font-family:var(--mono); font-size:.78rem; color:var(--accent-ink); }
  @media (max-width:820px){ .hero { grid-template-columns:1fr; gap:2rem; } }

  /* Live-run choreography: gate hidden states behind .js-ready (no-JS sees all) */
  :global(.yline) { display:block; }
  :global(.js-ready) .yline { opacity:0; transform:translateY(6px); }
  :global(.js-ready) .hero-live .yline.in { opacity:1; transform:none;
    transition:opacity .45s cubic-bezier(.16,1,.3,1), transform .45s cubic-bezier(.16,1,.3,1);
    transition-delay:calc(var(--i) * 140ms); }
  /* Command line "types": width 0→29ch with steps(); nowrap only on this short line */
  :global(.js-ready) .hero-live .hero-cmd.in { overflow:hidden; white-space:nowrap;
    animation:hero-type .9s steps(29) both; animation-delay:calc(var(--i) * 140ms); }
  @keyframes hero-type { from { width:0; } to { width:29ch; } }
  :global(.js-ready) .hero-gen { opacity:0; transform:translateY(10px); }
  :global(.js-ready) .hero-live .hero-gen.in { opacity:1; transform:none;
    transition:opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-ready) .yline, :global(.js-ready) .hero-gen { opacity:1; transform:none; transition:none; }
    :global(.js-ready) .hero-live .hero-cmd.in { animation:none; width:auto; white-space:pre-wrap; }
  }
</style>
