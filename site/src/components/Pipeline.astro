---
// How it works: three steps as a horizontal flow with rhythm (not a 3-col grid).
const steps = [
  { n:'01', k:'Describe', d:'A little YAML — only what native can\'t express.', code:'.cc-marketspec/catalog.yaml\nschemaVersion: "1.1"\ngroups:\n  - id: tools\n    label: Tools' },
  { n:'02', k:'Generate', d:'Joins your YAML with native manifests, validates.', code:'$ npx @xbluesky/cc-marketspec\ncc-marketspec: wrote .cc-marketspec/dist/manifest.json — 1 plugins, 0 warning(s).' },
  { n:'03', k:'.cc-marketspec/dist/manifest.json', d:'One render-agnostic document. Consume in the build or publish with the site.', code:'{ "schemaVersion": "1.1",\n  "marketplace": { "name": "cc-marketspec" },\n  "plugins": [ … ] }' },
];
---
<section id="how" class="section how">
  <div class="wrap">
    <span class="sec-num">03</span>
    <span class="eyebrow">The trace</span>
    <h2 class="how-h2">Three steps, no design decisions.</h2>
    <ol class="how-flow">
      {steps.map((s, i) => (
        <li class="how-step reveal" style={`--i:${i}`}>
          <span class="how-n">[{s.n}/03]</span>
          <h3 class="how-k">{s.k}</h3>
          <p class="how-d">{s.d}</p>
          <figure class="term how-term">
            <figcaption class="term-bar"><i></i><i></i><i></i><span>{s.k.toLowerCase()}</span></figcaption>
            <pre class="term-body"><code>{s.code.split('\n').map((ln, j) => <span class="tline" style={`--j:${j}`}>{ln}</span>)}</code></pre>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .how-h2 { font-size:clamp(1.8rem,4vw,2.6rem); margin:1rem 0 2rem; }
  .how-flow { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(3,1fr); gap:1.4rem; }
  .how-step { position:relative; padding-top:1rem; border-top:2px solid var(--accent); transition-delay:calc(var(--i) * 90ms); min-width:0; }
  .how-n { font-family:var(--mono); font-size:.8rem; color:var(--accent-ink); }
  .how-k { font-size:1.3rem; margin:.3rem 0 .5rem; }
  .how-d { color:var(--muted); font-size:.92rem; margin:0 0 1rem; }
  .how-term { margin:0; }
  .tline { display:block; }
  /* Trace types on scroll: each code line reveals as its terminal scrolls
     into view, staggered per line via a named view-timeline on the panel.
     Hidden states exist ONLY inside this @supports block, so browsers
     without scroll-timeline support (and JS-off — this is pure CSS) always
     see the full static trace. The `steps` data above is untouched — the
     line split happens at render time only. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .how-term { view-timeline:--how-term block; }
      .tline { opacity:0; transform:translateY(4px);
        animation:tline-in linear both;
        animation-duration:auto;
        animation-timeline:--how-term;
        animation-range:entry calc(var(--j) * 14%) entry calc(40% + var(--j) * 14%); }
    }
  }
  @keyframes tline-in { to { opacity:1; transform:none; } }
  @media (max-width:820px){ .how-flow { grid-template-columns:1fr; } }
</style>
